\f4\b0\fs26 \cf0 import \{ z \} from "zod";\
\
/**\
 * Supplier Onboarding Schema\
 * Corridor: Kenya 
\f5 \uc0\u8594 
\f4  Germany\
 * Product Scope: Nuts & Seeds (e.g. Macadamia)\
 */\
\
export const SupplierOnboardingSchema = z.object(\{\
  // --- Company Identity ---\
  companyName: z\
    .string()\
    .min(2, "Company name is required"),\
\
  country: z.literal("Kenya"),\
\
  legalEntityRegistered: z.boolean(),\
\
  // --- Product Scope ---\
  productCategory: z.enum([\
    "MACADAMIA",\
    "SESAME",\
    "CHIA",\
    "SUNFLOWER",\
    "OTHER"\
  ]),\
\
  // --- Capacity ---\
  annualCapacityTons: z\
    .number()\
    .min(1, "Minimum capacity is 1 ton")\
    .max(100000, "Capacity exceeds realistic limits"),\
\
  hasExportHistory: z.boolean(),\
\
  // --- Compliance (Hard Gates) ---\
  hasExportLicense: z.boolean(),\
\
  foodSafetyCertification: z.enum([\
    "BRCGS",\
    "IFS",\
    "FSSC_22000",\
    "NONE"\
  ]),\
\
  certificationDocumentUrl: z\
    .string()\
    .url("Invalid document URL")\
    .optional(),\
\
  // --- Food Safety Evidence ---\
  hasRecentLabTests: z.boolean(),\
\
  labTestDocumentUrl: z\
    .string()\
    .url("Invalid lab report URL")\
    .optional(),\
\
  // --- Traceability ---\
  traceabilityLevel: z.enum([\
    "NONE",\
    "BASIC",\
    "STRUCTURED"\
  ]),\
\
  // --- Logistics ---\
  priorContainerExports: z.boolean(),\
\
  // --- Commercial Clarity ---\
  incoterm: z.enum([\
    "FOB",\
    "CIF",\
    "EXW"\
  ]),\
\
  priceIndicationProvided: z.boolean()\
\})\
.refine(\
  (data) =>\
    data.foodSafetyCertification === "NONE"\
      ? true\
      : Boolean(data.certificationDocumentUrl),\
  \{\
    message: "Certification document required for selected scheme",\
    path: ["certificationDocumentUrl"]\
  \}\
)\
.refine(\
  (data) =>\
    data.hasRecentLabTests\
      ? Boolean(data.labTestDocumentUrl)\
      : true,\
  \{\
    message: "Lab test document required",\
    path: ["labTestDocumentUrl"]\
  \}\
);\
\
export type SupplierOnboardingInput = z.infer<\
  typeof SupplierOnboardingSchema\
>;\
